# ProStream Authentication & Auction System - Environment Variables Template

# ============================================================================
# MONGODB DATABASE CONFIGURATION (Required)
# ============================================================================
# Get this from MongoDB Atlas:
# 1. Go to MongoDB Atlas Dashboard
# 2. Click "Connect"
# 3. Choose "Drivers" → "Node.js"
# 4. Copy the connection string
# 5. Replace <password> with your actual password
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/prostream-auction?retryWrites=true&w=majority

# ============================================================================
# AUTHENTICATION CONFIGURATION (Required)
# ============================================================================
# For local development: http://localhost:3000
# For production: https://your-domain.com or https://your-vercel-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Generate a strong secret:
# openssl rand -base64 32
# Or use an existing one (must be consistent across all environments)
NEXTAUTH_SECRET=4swXgVjmEKX9eblwKFfHW/kP3YGIGJMGcXE67M/T6TY=

# ============================================================================
# GOOGLE OAUTH (Optional - for future use)
# ============================================================================
# Leave blank if not using Google Sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================================
# CLOUDINARY CONFIGURATION (For image uploads)
# ============================================================================
# Get from Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=   # Same as CLOUDINARY_CLOUD_NAME — needed for client-side image URL building

# ============================================================================
# PUSHER CONFIGURATION (Optional - for real-time updates)
# ============================================================================
# Leave blank if not using Pusher
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Public Pusher configuration (client-side)
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# ============================================================================
# API CONFIGURATION (For production deployments)
# ============================================================================
# For Vercel: https://your-app-name.vercel.app
# For localhost: http://localhost:3000
# Leave empty for same-origin API calls
NEXT_PUBLIC_API_URL=
